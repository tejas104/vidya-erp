# Vidya production reverse proxy. Terminates TLS and forwards to the web
# service over the internal compose network. Configured entirely by env vars
# (docker-compose.prod.yml / .env) — no edits needed to switch cert modes.
#
# Caddy substitutes {$VAR} from the environment BEFORE parsing, so TLS_DIRECTIVE
# can expand to a whole `tls ...` line — one file covers all three modes:
#
#   1. Automatic HTTPS (public domain, internet-reachable for ACME):
#        SITE_ADDRESS=erp.example.edu   TLS_DIRECTIVE=      (empty)
#      Caddy provisions + renews a Let's Encrypt cert using ACME_EMAIL.
#
#   2. Manually provisioned cert (air-gapped / intranet install):
#        SITE_ADDRESS=erp.college.local
#        TLS_DIRECTIVE=tls /certs/fullchain.pem /certs/privkey.pem
#      Drop the PEM files in ./certs (mounted read-only at /certs).
#
#   3. Self-signed (default — local test / evaluation):
#        SITE_ADDRESS=localhost   TLS_DIRECTIVE=tls internal
#      Caddy mints its own CA. Browsers warn; acceptable for the restore/TLS
#      verification drill.
#
# HTTP->HTTPS redirect is automatic: any request to :80 for an HTTPS site is
# 308-redirected to https. The plain-HTTP web service is never published.
{
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS:localhost} {
	{$TLS_DIRECTIVE:tls internal}

	encode gzip

	# Security headers (#10.5 Part 3).
	#
	# CSP / X-Frame-Options / nosniff / Referrer-Policy are already set by the
	# app itself (apps/web/next.config.ts headers()), which covers both pages
	# and API responses (Caddy only reverse-proxies to `web`, nothing else is
	# served here) — not duplicated in this file so there is one place that
	# declares them, not two that can drift apart.
	#
	# HSTS is the one header that belongs HERE and only here: it must never
	# appear while TLS_DIRECTIVE above is still the self-signed/local-eval
	# default (mode 3 in the header comment) or on a plain "localhost" install
	# — telling a browser to remember "always HTTPS for this origin" is very
	# hard to undo and actively harmful for a throwaway/dev install. So it is
	# opt-in and empty (i.e. absent) unless HSTS_DIRECTIVE is explicitly set —
	# see docker-compose.prod.yml, which documents exactly when that's safe
	# (real ACME or manually-provisioned TLS, never `tls internal`).
	header {
		{$HSTS_DIRECTIVE:}
		# Caddy's default Server header already carries no version string,
		# but drop it outright rather than rely on that not changing.
		-Server
	}

	# DO NOT add `trusted_proxies` here. Read this before touching the block.
	#
	# The app keys per-IP login rate limiting (and the IP in the auth audit
	# trail) off the FIRST hop of X-Forwarded-For — see the matching notes on
	# clientIp in packages/platform/src/http/define-route.ts and
	# packages/modules/identity/src/api/handlers.ts. That is only safe because
	# Caddy does not trust a client-supplied XFF by default: with no
	# trusted_proxies configured, the immediate peer is untrusted, so Caddy
	# REPLACES the header with the real remote address rather than appending
	# to it. Verified on caddy:2-alpine v2.11.4 — a request carrying a forged
	# `X-Forwarded-For: 1.2.3.4` reaches the upstream as the real client IP.
	#
	# Declaring trusted_proxies flips that: Caddy then preserves the client's
	# value and appends, so the forged hop arrives FIRST and every per-IP
	# limiter gets a fresh bucket per forged value — i.e. silently switched
	# off. If a real deployment ever needs this (an institution proxy in front
	# of Caddy), clientIp must be changed to read the correct hop at the same
	# time. See docs/threat-model-identity.md#throttle-keying.
	#
	# The other half of the same assumption lives in docker-compose.prod.yml,
	# which `!reset`s the web service's ports so Caddy is the only ingress.
	# Publish the app port directly and clients can forge XFF unmediated.
	reverse_proxy web:3000
}
