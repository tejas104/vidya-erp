# ============================================================================
# Vidya — production .env template.
#
# This is a TEMPLATE, not a config file: copy it to `.env` next to
# docker-compose.yml (mode 600, gitignored, NEVER commit it) and fill in real
# values. install.sh writes most of the [env] vars below for you on first
# run (secrets are generated, never printed) — you rarely need to hand-edit
# this, but every knob the app has is documented here so you know what
# exists and what breaks if it's wrong.
#
# Variable set is derived from packages/platform/src/config/env.ts (the
# actual zod schema the app validates against at boot — an unknown/invalid
# value fails config validation and the container refuses to start, it does
# NOT run with a silently-wrong value) plus the handful of vars the compose
# files and install.sh/update.sh read outside that schema (license, Caddy).
#
# Tags on each variable:
#   [env]     docker-compose.yml/.prod.yml read this from .env via ${VAR}
#             substitution — change it here, then re-run install.sh/update.sh
#             (or `docker compose up -d --build`) for it to take effect.
#   [fixed]   the app supports this (env.ts), but THIS compose stack
#             currently hard-codes a value in docker-compose.yml's
#             `environment:` block. Setting it here has NO EFFECT — you'd
#             need to edit docker-compose.yml itself. Listed anyway so you
#             know the knob exists.
#   [secret]  generate with `openssl rand -hex 24`-style randomness, never
#             reuse across installs, never commit.
# ============================================================================

# --- Core -------------------------------------------------------------------

# [fixed=production] Runtime mode. docker-compose.yml hard-codes NODE_ENV to
# "production" for web/worker — this also disables the demo seeder and dev
# error overlays. Never override to anything else for a real install.
NODE_ENV=production

# [env] Structured log verbosity: fatal|error|warn|info|debug|trace. Wrong/
# misspelled value fails config validation and the container won't boot.
# "debug" is fine temporarily for incident triage; noisy for daily use.
LOG_LEVEL=info

# --- PostgreSQL ---------------------------------------------------------------

# [env][secret] Postgres superuser password; DATABASE_URL is built from this
# automatically by the compose files. install.sh generates it once and never
# touches it again. Changing it after the volume exists locks you out of
# your own database until you also update Postgres's stored credential (or
# recreate the volume, losing data) — do not rotate by hand without reading
# docs/runbook-backup-restore.md first.
POSTGRES_PASSWORD=

# [fixed=10] Max Postgres connections opened per web/worker replica. Keep
# `replica_count * this <= Postgres max_connections` or you'll see
# connection-pool exhaustion errors under load. Edit docker-compose.yml to
# change (not wired to .env in this stack).
DATABASE_POOL_MAX=10

# --- Redis --------------------------------------------------------------------

# [fixed] REDIS_URL itself is hard-coded to redis://redis:6379 (the internal
# compose service name) — not settable here. KNOWN GAP (see
# docs/deployment-checklist.md): Redis holds sessions but has no AUTH
# configured in this stack yet; this is a real pre-production hardening item,
# not something this template can fix by itself.

# --- Object storage (MinIO in this stack; any S3-compatible store works) ------

# [env] MinIO root/access-key username. install.sh sets this to a
# non-default value ("vidya-prod"); wrong value here breaks every document
# upload/download (student docs, imports, report exports) with an auth error.
MINIO_ROOT_USER=vidya-prod

# [env][secret] MinIO root/secret-key password. Same blast radius as
# POSTGRES_PASSWORD if you change it after data exists.
MINIO_ROOT_PASSWORD=

# [fixed] S3_ENDPOINT/S3_REGION/S3_BUCKET/S3_FORCE_PATH_STYLE are hard-coded
# for the bundled MinIO service (http://minio:9000, us-east-1, "vidya",
# true). Only relevant to change if you point at an external S3-compatible
# store instead of the bundled MinIO container — that requires editing
# docker-compose.yml, not just this file.

# --- HTTP guards --------------------------------------------------------------

# [env] Comma-separated bare origins (scheme + host, no path) allowed to make
# state-changing requests, in addition to the app's own origin — this is
# CSRF layer 2. MUST equal your real browser origin, e.g.
# https://erp.yourcollege.edu. Wrong or missing value silently blocks every
# login and form submit as a forged-origin request; install.sh sets this
# automatically from the domain you give it.
TRUSTED_ORIGINS=

# [fixed=1048576] Request body size cap in bytes (1 MiB). CSV imports are
# capped well under this. Edit docker-compose.yml to raise it.
BODY_MAX_BYTES=1048576

# --- Sessions & login throttling (all [fixed] in this stack right now —
# docker-compose.yml hard-codes every one of these; edit it directly if you
# need different values) ------------------------------------------------------

# [fixed=vidya_session] Session cookie name. Only change to run two Vidya
# instances on the same domain.
SESSION_COOKIE_NAME=vidya_session

# [fixed] Whether the session cookie requires HTTPS. The prod overlay forces
# this to "true" unconditionally — correct, never run a real install without
# it. Only "false" in local dev (plain http).
SESSION_COOKIE_SECURE=true

# [fixed=12/30] Absolute session lifetime (hours) / idle timeout (minutes).
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30

# [fixed=30] Password-reset token validity, in minutes.
RESET_TOKEN_TTL_MINUTES=30

# [fixed=5/15] Reset-token redemption throttle: max attempts per IP within
# this many minutes before further attempts are blocked.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# [fixed=10/15] Account lockout: consecutive credential FAILURES for one
# username (not IP) before that account locks for the window below.
# Distinct from LOGIN_MAX_ATTEMPTS above. Auto-expires; an admin can also
# clear it early from the app.
LOGIN_LOCKOUT_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# --- Request-rate limiting (Redis-backed; NOT currently passed through by
# docker-compose.yml at all — the app always uses the built-in defaults
# below regardless of what you put here, until docker-compose.yml is
# extended to pass them. Documented for completeness / future wiring.) ------

RATE_LIMIT_LOGIN_IP_MAX=10
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_IP_BACKOFF_BASE_SECONDS=60
RATE_LIMIT_LOGIN_IP_BACKOFF_MAX_SECONDS=1800
RATE_LIMIT_LOGIN_IP_PENALTY_MEMORY_SECONDS=3600
RATE_LIMIT_LOGIN_USERNAME_MAX=5
RATE_LIMIT_LOGIN_USERNAME_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_MAX=3
RATE_LIMIT_PASSWORD_WINDOW_SECONDS=60
RATE_LIMIT_SESSION_MAX=300
RATE_LIMIT_SESSION_WINDOW_SECONDS=60

# --- Product edition & licensing -----------------------------------------------

# [env] "college" or "school". Drives CSV import template headers and which
# help content is shown — nothing else in the app is edition-aware yet. Must
# match the edition your license.json was issued for, or install.sh's
# license gate (step 4) refuses to proceed. Wrong value here also fails
# config validation outright (it's a strict enum) and the container won't
# boot. install.sh prompts for this and writes it once.
VIDYA_EDITION=college

# [env] Inline license token (the contents of license.json, whitespace
# stripped), read by web/worker at boot to show status on the admin System
# page. Presentation only — nothing here ever blocks the app from running,
# valid, expired, or absent. Wins over VIDYA_LICENSE_FILE if both are set.
# Prefer VIDYA_LICENSE_FILE below for most installs (see license/README.md
# in this bundle for how to obtain and place license.json); this inline form
# exists for orchestrators that inject secrets as env vars rather than
# mounted files.
VIDYA_LICENSE=

# [env] Path INSIDE THE CONTAINER to a mounted license file, used only when
# VIDYA_LICENSE (above) is empty. install.sh mounts license.json at the
# container path implied by this stack's compose setup automatically — you
# normally don't need to set this by hand.
VIDYA_LICENSE_FILE=

# [install.sh bookkeeping — NOT read by the app/containers at all] Path ON
# THE HOST to your license file, e.g. ./license.json. install.sh writes this
# once at step 4 and update.sh re-reads it on every future update to run the
# license/edition gate (docs/update-guide.md) — it is a completely separate
# thing from VIDYA_LICENSE_FILE above (that one's a path inside a
# container). Do not confuse the two. Installation aborts at step 4 without
# a valid license file at this path — see license/README.md in this bundle
# for how to obtain one.
VIDYA_LICENSE_PATH=./license.json

# --- Demo data (evaluation only — never true in production) -------------------

# [seed-demo.ts reads this directly, not via env.ts] Set to exactly "true"
# to allow `pnpm seed:demo` to create a self-contained demo college with
# well-known passwords. Hard-blocked under NODE_ENV=production regardless,
# but leave this unset/false anyway — it is a real risk if a later change
# ever loosens that guard. See docs/getting-started.md.
VIDYA_ALLOW_DEMO_SEED=false

# --- Analytics (all [fixed] in this stack — edit docker-compose.yml) ----------

# [fixed=5] Aggregates over fewer than this many distinct students are
# withheld entirely rather than shown (small-N privacy guard, ADR-0018).
# Do not lower without a privacy review.
ANALYTICS_MIN_COHORT=5

# [fixed=75/40] "At risk" flag thresholds: attendance % and marks % (of
# max). Changes take effect on next rebuild/restart, not live.
ANALYTICS_ATTENDANCE_THRESHOLD=75
ANALYTICS_MARKS_THRESHOLD=40

# --- Worker process (all [fixed]) ----------------------------------------------

# [fixed=9464] Prometheus metrics port for the worker. Should only ever be
# reachable from your scrape network, never the public internet.
WORKER_METRICS_PORT=9464

# [fixed=300000] System heartbeat / canary cadence in milliseconds (5 min).
SYSTEM_HEARTBEAT_INTERVAL_MS=300000

# --- Graceful shutdown (all [fixed]) -------------------------------------------

# [fixed=5000/15000] Drain time before closing connections, then hard
# timeout, in milliseconds, on SIGTERM. If you run under an orchestrator
# with its own shutdown grace period, that period must exceed
# drain + timeout or you'll see connections cut mid-request.
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=15000

# --- Internal version stamp (not compose-wired; do not set by hand) -----------
# [default-only] SERVICE_VERSION is a log-line label the app defaults on its
# own; the version shown on the admin System page comes from package.json +
# GIT_SHA at Docker build time instead (see docs/deployment-checklist.md),
# not from this variable.

# ============================================================================
# --- Reverse proxy / TLS (Caddy, docker-compose.prod.yml + Caddyfile) --------
# ============================================================================

# [env] The domain (or bare LAN IP/hostname) Caddy serves and, in automatic
# mode, requests a Let's Encrypt certificate for. install.sh asks for this
# and writes it.
SITE_ADDRESS=localhost

# [env] Contact address for Let's Encrypt account + expiry notices. Only
# used in automatic-HTTPS mode (TLS_DIRECTIVE empty).
ACME_EMAIL=admin@example.com

# [env] Selects the TLS mode — see Caddyfile's header comment for the three
# options. Empty = automatic ACME (needs a public domain + 80/443 reachable
# from the internet). "tls internal" = self-signed (default; browsers warn,
# fine for LAN/eval). "tls /certs/fullchain.pem /certs/privkey.pem" = a
# manually provisioned cert dropped in ./certs/.
TLS_DIRECTIVE=tls internal

# [env] HSTS header value. Deliberately EMPTY by default — see Caddyfile:
# sending "always use HTTPS" for an origin that isn't durably, trustedly
# HTTPS (self-signed / local-eval) is actively harmful and hard to undo in
# a browser. Only set this once TLS_DIRECTIVE points at a real ACME or
# manually-provisioned certificate, e.g.:
#   HSTS_DIRECTIVE=Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
HSTS_DIRECTIVE=

# ============================================================================
# Intentionally NOT in this file:
#   VIDYA_ADMIN_PASSWORD — never stored anywhere. install.sh prompts for it
#     interactively at step 6 and passes it straight through to the one-shot
#     admin-bootstrap command; it is shown on screen exactly once and never
#     written to disk or logs.
#   GIT_SHA — set automatically by install.sh/update.sh from `git rev-parse`
#     at build/deploy time, not something an operator sets in .env.
# ============================================================================
